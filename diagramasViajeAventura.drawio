        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    Admin([\&quot;👤 Administrador\&quot;])\n    Cliente([\&quot;👤 Cliente\&quot;])\n\n    subgraph Sistema[\&quot;Viajes Aventura - Sistema de Gestión Turística\&quot;]\n        direction TB\n        %% Gestión de Sistema\n        UC_REG([\&quot;Registrarse en el sistema\&quot;])\n        UC_LOGIN([\&quot;Autenticar usuario\&quot;])\n        UC_VAL([\&quot;Validar datos ingresados\&quot;])\n\n        %% Gestión de Destinos\n        UC_DEST_REG([\&quot;Registrar destino\&quot;])\n        UC_DEST_MOD([\&quot;Modificar destino\&quot;])\n        UC_DEST_DEL([\&quot;Eliminar / Desactivar destino\&quot;])\n        UC_DEST_LST([\&quot;Listar destinos disponibles\&quot;])\n\n        %% Gestión de Paquetes\n        UC_PAQ_CRE([\&quot;Crear paquete turístico\&quot;])\n        UC_PAQ_COST([\&quot;Calcular costo por destinos\&quot;])\n        UC_PAQ_DISP([\&quot;Consultar disponibilidad de paquetes\&quot;])\n\n        %% Gestión de Reservas y Pasajeros\n        UC_RES_NEW([\&quot;Realizar reserva de paquete\&quot;])\n        UC_PAS_REG([\&quot;Registrar pasajeros de la reserva\&quot;])\n        UC_RES_HIST([\&quot;Consultar historial de reservas\&quot;])\n        UC_PAS_CONS([\&quot;Consultar pasajeros del viaje\&quot;])\n    end\n\n    %% Relaciones Administrador\n    Admin --- UC_LOGIN\n    Admin --- UC_DEST_REG\n    Admin --- UC_DEST_MOD\n    Admin --- UC_DEST_DEL\n    Admin --- UC_DEST_LST\n    Admin --- UC_PAQ_CRE\n    Admin --- UC_PAQ_DISP\n\n    %% Relaciones Cliente\n    Cliente --- UC_REG\n    Cliente --- UC_LOGIN\n    Cliente --- UC_DEST_LST\n    Cliente --- UC_PAQ_DISP\n    Cliente --- UC_RES_NEW\n    Cliente --- UC_RES_HIST\n    Cliente --- UC_PAS_CONS\n\n    %% Relaciones Include\n    UC_REG -.-&gt;|\&quot;«include»\&quot;| UC_VAL\n    UC_DEST_REG -.-&gt;|\&quot;«include»\&quot;| UC_VAL\n    UC_DEST_MOD -.-&gt;|\&quot;«include»\&quot;| UC_VAL\n    UC_PAQ_CRE -.-&gt;|\&quot;«include»\&quot;| UC_VAL\n    UC_PAQ_CRE -.-&gt;|\&quot;«include»\&quot;| UC_PAQ_COST\n    UC_RES_NEW -.-&gt;|\&quot;«include»\&quot;| UC_LOGIN\n    UC_RES_NEW -.-&gt;|\&quot;«include»\&quot;| UC_PAS_REG\n    UC_RES_NEW -.-&gt;|\&quot;«include»\&quot;| UC_PAQ_DISP\n    UC_PAS_REG -.-&gt;|\&quot;«include»\&quot;| UC_VAL\n    UC_PAS_CONS -.-&gt;|\&quot;«include»\&quot;| UC_LOGIN&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Iy2tuLoXtw0RCAO4pcrK-1">
