  <diagram id="9WUUyNK4ZxrZMiCC_OmF" name="diagrama bpmn">
    <mxGraphModel dx="2929" dy="1625" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    subgraph Pool[\&quot;Pool: Viajes Aventura\&quot;]\n        direction TB\n\n        subgraph LaneAdmin[\&quot;Carril: Administrador\&quot;]\n            A_START((Inicio)) --&gt; A_DEST[\&quot;Ingresar datos de destino&lt;br/&gt;(nombre, país, ciudad, costo)\&quot;]\n            A_PAQ[\&quot;Crear paquete y asignar&lt;br/&gt;destinos, fechas y cupos\&quot;]\n        end\n\n        subgraph LaneSistema[\&quot;Carril: Sistema\&quot;]\n            S_VAL1[\&quot;Validar datos de destino\&quot;]\n            S_GW1{\&quot;¿Datos&lt;br/&gt;válidos?\&quot;}\n            S_ERR1[\&quot;Mostrar mensaje de corrección\&quot;]\n            S_SAVE_DEST[\&quot;Guardar destino en BD\&quot;]\n\n            S_CALC[\&quot;Calcular costo total y&lt;br/&gt;validar paquete\&quot;]\n            S_GW2{\&quot;¿Paquete&lt;br/&gt;válido?\&quot;}\n            S_PUB[\&quot;Publicar paquete disponible\&quot;]\n\n            S_AUTH[\&quot;Autenticar credenciales&lt;br/&gt;(verificar hash)\&quot;]\n            S_GW3{\&quot;¿Acceso&lt;br/&gt;autorizado?\&quot;}\n            S_DISP[\&quot;Verificar cupos disponibles y&lt;br/&gt;validar datos de pasajeros\&quot;]\n            S_GW4{\&quot;¿Hay cupos&lt;br/&gt;y datos OK?\&quot;}\n            S_ERR_RES[\&quot;Notificar rechazo /&lt;br/&gt;corregir datos\&quot;]\n            S_SAVE_RES[\&quot;Guardar reserva, registrar&lt;br/&gt;pasajeros y descontar cupos\&quot;]\n        end\n\n        subgraph LaneCliente[\&quot;Carril: Cliente\&quot;]\n            C_LOGIN[\&quot;Iniciar sesión y consultar&lt;br/&gt;paquetes disponibles\&quot;]\n            C_REQ[\&quot;Seleccionar paquete, cupos e&lt;br/&gt;ingresar datos de pasajeros\&quot;]\n            C_CONF[\&quot;Consultar confirmación,&lt;br/&gt;historial y datos de pasajeros\&quot;]\n            C_END(((Fin)))\n        end\n    end\n\n    %% Flujo Destinos\n    A_DEST --&gt; S_VAL1\n    S_VAL1 --&gt; S_GW1\n    S_GW1 -- \&quot;No\&quot; --&gt; S_ERR1\n    S_ERR1 -- \&quot;Corregir y reingresar\&quot; --&gt; A_DEST\n    S_GW1 -- \&quot;Sí\&quot; --&gt; S_SAVE_DEST\n    S_SAVE_DEST --&gt; A_PAQ\n\n    %% Flujo Paquetes\n    A_PAQ --&gt; S_CALC\n    S_CALC --&gt; S_GW2\n    S_GW2 -- \&quot;No\&quot; --&gt; A_PAQ\n    S_GW2 -- \&quot;Sí\&quot; --&gt; S_PUB\n    S_PUB --&gt; C_LOGIN\n\n    %% Flujo Reservas y Pasajeros\n    C_LOGIN --&gt; S_AUTH\n    S_AUTH --&gt; S_GW3\n    S_GW3 -- \&quot;No\&quot; --&gt; C_LOGIN\n    S_GW3 -- \&quot;Sí\&quot; --&gt; C_REQ\n    C_REQ --&gt; S_DISP\n    S_DISP --&gt; S_GW4\n    S_GW4 -- \&quot;No\&quot; --&gt; S_ERR_RES\n    S_ERR_RES --&gt; C_REQ\n    S_GW4 -- \&quot;Sí\&quot; --&gt; S_SAVE_RES\n    S_SAVE_RES --&gt; C_CONF\n    C_CONF --&gt; C_END&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="cDo1cRrX3v0Ohexste7h-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
