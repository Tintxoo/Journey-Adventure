      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Rol {\n        -int idRol\n        -str nombreRol\n        -str descripcion\n        +obtenerPermisos() list~str~\n    }\n\n    class Usuario {\n        -int idUsuario\n        -str nombreCompleto\n        -str email\n        -str passwordHash\n        -str documentoIdentidad\n        -str telefono\n        -int intentosFallidos\n        -bool activo\n        -datetime fechaRegistro\n        +registrar() bool\n        +autenticar(email: str, password: str) bool\n        +validarDatos() bool\n        +cifrarDatosSensibles() None\n        +consultarHistorialReservas() list~Reserva~\n    }\n\n    class Destino {\n        -int idDestino\n        -str nombre\n        -str pais\n        -str ciudad\n        -str descripcion\n        -decimal costoBase\n        -bool disponible\n        -datetime fechaCreacion\n        +registrar() None\n        +modificar() None\n        +eliminarLogico() None\n        +validar() bool\n    }\n\n    class PaqueteTuristico {\n        -int idPaquete\n        -str nombrePaquete\n        -str descripcion\n        -date fechaInicio\n        -date fechaFin\n        -decimal costoTotal\n        -int cuposTotales\n        -int cuposDisponibles\n        -str estado\n        +agregarDestino(destino: Destino, orden: int, dias: int, costo: decimal) None\n        +calcularCostoTotal() decimal\n        +verificarDisponibilidad(personas: int) bool\n        +descontarCupos(personas: int) None\n        +validarItinerario() bool\n    }\n\n    class PaqueteDestino {\n        -int idPaqueteDestino\n        -int ordenItinerario\n        -int diasEstadia\n        -decimal costoAsignado\n        +cambiarOrden(nuevoOrden: int) None\n        +recalcularSubtotal() decimal\n    }\n\n    class Reserva {\n        -int idReserva\n        -str codigoReserva\n        -datetime fechaReserva\n        -int cantidadPersonas\n        -decimal montoTotal\n        -str estadoReserva\n        -str observaciones\n        +crearReserva() bool\n        +agregarPasajero(pasajero: Pasajero) None\n        +obtenerPasajeros() list~Pasajero~\n        +confirmar() None\n        +cancelar() None\n        +calcularMontoFinal() decimal\n    }\n\n    class Pasajero {\n        -int idPasajero\n        -str nombreCompleto\n        -str documentoIdentidad\n        -date fechaNacimiento\n        -str telefonoContacto\n        -bool esTitular\n        +validarDatos() bool\n        +cifrarDocumento() None\n    }\n\n    Rol \&quot;1\&quot; -- \&quot;0..*\&quot; Usuario : asigna\n    Usuario \&quot;1\&quot; -- \&quot;0..*\&quot; Reserva : realiza\n    PaqueteTuristico \&quot;1\&quot; -- \&quot;0..*\&quot; Reserva : es reservado en\n    PaqueteTuristico \&quot;1\&quot; *-- \&quot;1..*\&quot; PaqueteDestino : incluye\n    Destino \&quot;1\&quot; -- \&quot;0..*\&quot; PaqueteDestino : se usa en\n    Reserva \&quot;1\&quot; *-- \&quot;1..*\&quot; Pasajero : incluye&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Fadh9ZbOiDC_-8FyMEN6-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
