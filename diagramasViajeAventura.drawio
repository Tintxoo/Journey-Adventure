tidad\n        date fecha_nacimiento\n        string telefono_contacto\n        boolean es_titular\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Ll5z5fRTpmi29jMazix--1">
